{
  "repository": "Share2Gemni-Extensions",
  "version": "1.2.0",
  "updatedAt": "2026-10-12",
  "extensions": [
    {
      "id": "com.share2gemini.ext.instagram",
      "name": "Instagram Downloader",
      "version": "1.1.0",
      "description": "Download Instagram Reels, Video Posts, and Stories directly using yt-dlp & FFmpeg for Gemini AI analysis.",
      "author": "Priydarshansingh",
      "platform": "instagram",
      "supportedDomains": [
        "instagram.com",
        "instagr.am",
        "www.instagram.com"
      ],
      "urlPatterns": [
        "^https?://(www\\.)?instagram\\.com/(reel|reels|p|stories|tv)/[A-Za-z0-9_-]+.*"
      ],
      "strategy": "yt-dlp",
      "apiEndpoints": [
        {
          "url": "https://api.cobalt.tools",
          "method": "POST",
          "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json"
          },
          "bodyTemplate": "{\"url\": \"{{URL}}\", \"videoQuality\": \"720\"}",
          "responsePath": "url"
        }
      ],
      "htmlExtractRules": {
        "ogVideo": "meta[property='og:video']",
        "ogImage": "meta[property='og:image']"
      }
    },
    {
      "id": "com.share2gemini.ext.youtube",
      "name": "YouTube & Shorts Downloader",
      "version": "1.1.0",
      "description": "Download YouTube videos and Shorts seamlessly using native yt-dlp & FFmpeg for Gemini summarization.",
      "author": "Priydarshansingh",
      "platform": "youtube",
      "supportedDomains": [
        "youtube.com",
        "youtu.be",
        "www.youtube.com",
        "m.youtube.com"
      ],
      "urlPatterns": [
        "^https?://(www\\.|m\\.)?(youtube\\.com|youtu\\.be)/(watch\\?v=|shorts/|[A-Za-z0-9_-]+).*"
      ],
      "strategy": "yt-dlp",
      "apiEndpoints": [
        {
          "url": "https://api.cobalt.tools",
          "method": "POST",
          "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json"
          },
          "bodyTemplate": "{\"url\": \"{{URL}}\", \"videoQuality\": \"720\"}",
          "responsePath": "url"
        }
      ]
    },
    {
      "id": "com.share2gemini.ext.twitter",
      "name": "Twitter / X Media Downloader",
      "version": "1.1.0",
      "description": "Download videos, GIFs, and media attachments from tweets on Twitter and X with native yt-dlp.",
      "author": "Priydarshansingh",
      "platform": "twitter",
      "supportedDomains": [
        "twitter.com",
        "x.com",
        "www.twitter.com",
        "www.x.com"
      ],
      "urlPatterns": [
        "^https?://(www\\.)?(twitter\\.com|x\\.com)/.+/status/\\d+.*"
      ],
      "strategy": "yt-dlp",
      "apiEndpoints": [
        {
          "url": "https://api.vxtwitter.com/{{PATH}}",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          },
          "responsePath": "media_extended.0.url"
        },
        {
          "url": "https://api.cobalt.tools",
          "method": "POST",
          "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json"
          },
          "bodyTemplate": "{\"url\": \"{{URL}}\"}",
          "responsePath": "url"
        }
      ]
    },
    {
      "id": "com.share2gemini.ext.tiktok",
      "name": "TikTok Video & Media Downloader",
