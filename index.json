      ],
      "strategy": "yt-dlp",
      "apiEndpoints": [
        {
          "url": "https://api.cobalt.tools",
          "method": "POST",
          "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json"
          },
          "bodyTemplate": "{\"url\": \"{{URL}}\"}",
          "responsePath": "url"
        }
      ]
    },
