{
  "id": "com.share2gemini.ext.facebook",
  "name": "Facebook Video & Reels Downloader",
  "version": "1.2.0",
  "description": "Download Facebook Reels, Watch videos, and public video posts natively using yt-dlp & FFmpeg.",
  "author": "Priydarshansingh",
  "platform": "facebook",
  "supportedDomains": [
    "facebook.com",
    "fb.watch",
    "www.facebook.com",
    "m.facebook.com",
    "fb.com"
  ],
  "urlPatterns": [
    "^https?://(www\\.|m\\.)?(facebook\\.com/(reel/\\d+|watch/\\?v=\\d+|.+/videos/\\d+)|fb\\.watch/\\w+).*"
  ],
  "strategy": "yt-dlp",
  "apiEndpoints": [
    {
      "url": "https://api.cobalt.tools",
      "method": "POST",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json"
      },
      "bodyTemplate": "{\"url\": \"{{URL}}\"}",
      "responsePath": "url"
    }
  ]
}
