{
  "id": "com.share2gemini.ext.twitter",
  "name": "Twitter / X Media Downloader",
  "version": "1.2.1",
  "description": "Download videos, GIFs, and media attachments from tweets on Twitter and X for Gemini analysis.",
  "author": "Priydarshansingh",
  "platform": "twitter",
  "supportedDomains": [
    "twitter.com",
    "x.com",
    "www.twitter.com",
    "www.x.com"
  ],
  "urlPatterns": [
    "^https?://(www\\.)?(twitter\\.com|x\\.com)/.+/status/\\d+.*"
  ],
  "strategy": "native-stream",
  "apiEndpoints": [
    {
      "url": "https://api.vxtwitter.com/{{PATH}}",
      "method": "GET",
      "headers": {
        "Accept": "application/json"
      },
      "responsePath": "media_extended.0.url"
    }
  ]
}
