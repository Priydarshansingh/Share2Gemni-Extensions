{
  "id": "com.share2gemini.ext.instagram",
  "name": "Instagram Downloader",
  "version": "1.2.1",
  "description": "Extract Instagram Reels, Video Posts, and Stories directly for Gemini AI analysis.",
  "author": "Priydarshansingh",
  "platform": "instagram",
  "supportedDomains": [
    "instagram.com",
    "instagr.am",
    "www.instagram.com"
  ],
  "urlPatterns": [
    "^https?://(www\\.)?instagram\\.com/(reel|reels|p|stories|tv)/[A-Za-z0-9_-]+.*"
  ],
  "strategy": "native-stream",
  "apiEndpoints": [],
  "htmlExtractRules": {
    "ogVideo": "meta[property='og:video']",
    "ogImage": "meta[property='og:image']"
  }
}
